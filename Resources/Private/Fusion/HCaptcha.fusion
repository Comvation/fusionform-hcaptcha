prototype(Comvation.FusionForm.HCaptcha:HCaptcha) < prototype(Neos.Fusion.Form:Component.Field) {
  formSelector = ${Configuration.setting('Comvation.FusionForm.HCaptcha.formSelector')}
  siteKey = ${Configuration.setting('Comvation.FusionForm.HCaptcha.siteKey')}
  @context.size = ${Configuration.setting('Comvation.FusionForm.HCaptcha.size')}
  theme = ${Configuration.setting('Comvation.FusionForm.HCaptcha.theme')}
  scriptSrc = Neos.Fusion:ResourceUri {
    path = 'resource://Comvation.FusionForm.HCaptcha/Public/JavaScript/captchaCallback.js'
  }
  @context.language = ${Neos.Dimension.currentValue(node, 'language').value}
  languageParameter = ${language ? "&hl=" + language : ''}
  onloadParameter = ${size == 'invisible' ? '?onload=captchaLoaded' : ''}

  renderer = afx`
    <script src={props.scriptSrc}></script>
    <script async defer src={
      "https://js.hcaptcha.com/1/api.js"
      + props.onloadParameter
      + props.languageParameter
      }></script>
    <input type="hidden" id="captcha-token" name={field.name} value="" />
    <div class="h-captcha" id="captcha-container"
      data-callback="captchaCallback"
      data-formSelector={props.formSelector}
      data-sitekey={props.siteKey}
      data-size={size}
      data-theme={props.theme}
    >
    </div>
  `
}
